mpause 2000
sendln 'lcmd_resp on'
filedelete 'C:\SCRIPT\GRDUMP\DUMP.OK'
filedelete 'C:\SCRIPT\GRDUMP\DUMP.ERR'
filedelete 'C:\SCRIPT\GRDUMP\GRDUMP.LCK'
attempts = 0
:run
sendln 'lcmd sh /media/storage1/SCRIPT/GRDUMP/DUMP.SH'
filesearch 'C:\SCRIPT\GRDUMP\DUMP.OK'
if result != 0 goto done
filesearch 'C:\SCRIPT\GRDUMP\DUMP.ERR'
if result != 0 goto done
mpause 1000
attempts = attempts + 1
if attempts < 120 goto run
:done
end
